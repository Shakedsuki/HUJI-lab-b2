\begin_layout Standard
מערכת דטרמנייטסית מכונה 
\series bold
כאוטית
\series default
 כאשר היא מגלה רגישות לתנאי ההתחלה שלה:
 שני מסלולים היוצאים ממצבים כמעט זהים במהרה מתרחקים זה מזה במהירות אקספוננציאלית,
 כך שחיזוי של התנועה לאורך טווח כמעט ובלתי ניתן הלכה-למעשה.
 
\begin_inset Foot
status open

\begin_layout Plain Layout
משהו משהו אינטגרציה נומרית משהו משהו רמאות
\end_layout

\end_inset

 עבור מטוטלת כפולה מאולצת פירוש הדבר שלא ניתן להכריע רק ממבט חטוף על תנועתה אם תדירות האילוץ הנתונה מייצרת כאוס או לא;
 זוהי תכונה של האופן שבו ממלא מסלול המטוטלת את מרחב המצבים (
\begin_inset Formula $\text{state space}$
\end_inset

) לאורך הזמן,
 כפי שנציג בהמשך הדו
\begin_inset Quotes qrd
\end_inset

ח.
 ההבחנה הישירה ביותר בין שני המצבים מתקבלת במרחב הפאזה,
 שבו מצב המערכת משרטט מסלול לאורך הזמן (בפועל אנו מתבוננים על ההיטל הדו-ממדי של מרחב המצב הארבע-ממדי).
 תנועה סדורה ומחזורית מתכנסת במרחב הפאזה אל לולאות סגורות (
\begin_inset Formula $\text{limit cycle}$
\end_inset

) ואילו תנועה כאוטית לעולם אינה נסגרת אלא ממשיכה למלא תחום חסום אך כזה שאינו חוזר על עצמו (
\begin_inset Formula $\text{strange attractor}$
\end_inset

).
 על כן,
 השוואת ה-
\begin_inset Formula $\text{phase portrait}$
\end_inset

 של כל מדידה כנגד שני מושגים אלו היא אפוא המבחן הוויזואלי המיידי ביותר להבחנה בין תנועה סדורה לכאוטית.
\end_layout

\begin_layout Standard
לצד המבט האיכותני על המערכת,
 מבט משלים וכמותי מתקבל מה-
\begin_inset Formula $\text{power spectrum}$
\end_inset

 (התמרת הפורייה) של זווית המוט התחתון 
\begin_inset Formula $\theta_{2}$
\end_inset

:
 תנועה מחזורית או נעולת-פאזה מרכזת את העוצמה בכמה קווים דיסקרטיים (המתארים את תדירות האילוץ וההרמוניות שלה),
 בעוד שתנועה כאוטית מפזרת את העוצמה על פני רצועה רחבה ורציפה יותר.
 את ניגודיות זו של העוצמה אנו מכמתים באמצעות מספר יחיד הנקרא האנטרופיה המרחבית/הספקטרלית 
\begin_inset Formula $H_{\theta_{2}}$
\end_inset

 (
\begin_inset Formula $\text{spectral entropy}$
\end_inset

) ,
 כאשר 
\begin_inset Formula $H_{\theta_{2}}\approx0$
\end_inset

 מתאר תנועה סדורה בעלת מספר פיקים חדים,
 ו- 
\begin_inset Formula $H_{\theta_{2}}\approx1$
\end_inset

 עבור תנועה כאוטית,
 עם ספקטרום תדרים רחב ורועש.
 
\end_layout

\begin_layout Standard
מכיוון שעל שני המוטות במערכת המטוטולת הכפולה ניתן להסתכל כזוג אוסילטורים מצומדים,
 יהיה יאה בנוסף לסדירות התנועה ללדבר גם על קוהרנטיות וסינכרון המוטות לאורך המדידה.
 קרי,
 אנו מייחסים לכל מוט פאזה רגעית ומודדים עד כמה יציב הפרש הפאזות 
\begin_inset Formula $\phi_{1}-\phi_{2}$
\end_inset

 באמצעות הפרמטר:
\begin_inset Formula 
\begin{equation}
\rho=\left|\left\langle e^{i\left(\phi_{1}-\phi_{2}\right)}\right\rangle \right|
\end{equation}

\end_inset

 הנקרא גם פרמטר הסדר של קוראמוטו.
 הפרש פאזות הנותר קבוע נותן 
\begin_inset Formula $\rho\approx1$
\end_inset

 (המתאר מצב בו המוטות נעולים בפאזה והתנועה סדורה),
 ואילו הפרש פאזות שאינו נותר קבוע מתמצע לכדי 
\begin_inset Formula $\rho\approx0$
\end_inset

 (המתאר תנועה כאוטית).
\end_layout

\begin_layout Standard
לבסוף,
 מכיוון שהמנוע המחובר למטוטלת הכפולה מזריק זרם אנרגיה למערכת,
 האנרגיה המכאנית במצב העמיד 
\begin_inset Formula $E=T+U$
\end_inset

 - אנרגיה קינטית ופוטנציאלית,
 המחושבת מן הזוויות והמהירויות הזוויות הנמדדות - מודדת עד כמה כל תדירות אילוץ מעוררת את המערכת.
 בהצגתה כתלות בתדירות האילוץ 
\begin_inset Formula $f_{drive}$
\end_inset

 מופיע שיא רזוננס סמוך ל- 
\begin_inset Formula $0.95\text{Hz}$
\end_inset

,
 שבו האילוץ מזריק אנרגיה אל המטוטלת ביעילות הגבוהה ביותר (זוהי גם אחת הסיבות מאחורי מדוע רצועת הכאוס נפתחת סביב תדירות הרזוננס ונמשכת לתדירויות אילוץ גבוהות יותר).
 כפי שראינו גם במכניקה אנליטית,
 נוכל לקשר בין האנרגיה הקינטית והפוטנציאלית באמצעות משפט הויריאל,
 הקובע את האיזון בין ממוצע הזמן לבין האנרגיה הקינטית והפוטנציאלית.
 כך שעבור פוטנציאל הרמוני בתנודות קטנות,
 ראינו כי 
\begin_inset Formula $\left\langle T\right\rangle =\left\langle U\right\rangle $
\end_inset

 (קרי יחס ויריאלי של 
\begin_inset Formula $\frac{T}{U}=1$
\end_inset

) ולכן נוכל לפרש כל סטייה של היחס הזה מגודל יחידה לכדי אינדיקציה נוספת לכמה התרחקה התנודה המאולצת של המטוטלת מתחום התנודות ההרמוניות לכאוס.
\end_layout

