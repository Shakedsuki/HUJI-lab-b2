# ── Videos ──────────────────────────────────────
# All raw video files — too large for git (~3 GB total)
phase1-free-swing/data/videos/*.mov
phase1-free-swing/data/videos/*.mp4
phase1-free-swing/data/videos/*.avi
phase2-motor-driven/videos/*.mov
phase2-motor-driven/videos/*.mp4
phase2-motor-driven/videos/*.avi

# ── Extracted frames ─────────────────────────────
# Generated by ffmpeg, can be re-extracted anytime
frames/

# ── Per-measurement outputs ──────────────────────
# Large/regenerable artefacts produced inside measurements/<config>/.
# Small human-readable artefacts (tracking.csv, etc.) stay tracked
# so the repo always shows what's been measured at a glance.
phase1-free-swing/measurements/*/debug.mp4
phase1-free-swing/measurements/*/phase_3d_rotation.mp4
phase1-free-swing/measurements/*/phase_animation.mp4
phase1-free-swing/measurements/*/combined.mp4

# ── Figures layout ───────────────────────────────
# Per-clip MP4s (rendered animations) regenerable from CSV — too big
# to track. PNG figures stay tracked for at-a-glance browsing.
phase1-free-swing/figures/phase_3d_rotation/*.mp4
phase1-free-swing/figures/phase_animation/*.mp4
phase1-free-swing/figures/combined/*.mp4
phase1-free-swing/figures/debug/*.mp4

# Migration / bulk-tracking sidecar logs
phase1-free-swing/data/migration_log.txt
phase1-free-swing/data/bulk_tracking_log.json
# Long-render stdout logs from analysis scripts
phase1-free-swing/data/log_*.txt
phase1-free-swing/data/*_log.txt
# Per-video verdict-card transcript appended by track_one.py
phase1-free-swing/data/track_one_log.txt
# Bulk-run streaming logs (one per chaos bulk invocation)
phase1-free-swing/data/bulk_run_*.log
# Batch driver logs (phase analysis, render batches, etc.)
phase1-free-swing/data/*batch_log.txt

# Tracking-CSV backups (interpolate_suspects, fix_green_swaps, etc.)
phase1-free-swing/measurements/*/tracking.csv.bak*

# Registry backups created by bulk_track.py
phase1-free-swing/data/experiments.json.bulk_track_*.bak
phase1-free-swing/data/experiments.json.*.bak

# Personal VS Code workspace
*.code-workspace
.vscode/

# ── Claude worktrees ─────────────────────────────
.claude/

# ── Python cache ─────────────────────────────────
__pycache__/
*.pyc
*.pyo

# ── Part 1 & 2 samples (large oscilloscope data, not tracked) ────
phase1-free-swing/chaos/part1/samples/
phase1-free-swing/chaos/part2/samples/

# ── Windows OS files ─────────────────────────────
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk
.DS_Store
