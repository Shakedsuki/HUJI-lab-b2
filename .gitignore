# ── Videos ──────────────────────────────────────
# All raw video files — too large for git (~3 GB+ total)
week3-pendulum-free-swing/data/videos/*.mov
week3-pendulum-free-swing/data/videos/*.mp4
week3-pendulum-free-swing/data/videos/*.avi
week4-pendulum-motor-driven/videos/*.mov
week4-pendulum-motor-driven/videos/*.mp4
week4-pendulum-motor-driven/videos/*.avi

# ── Extracted frames ─────────────────────────────
# Generated by ffmpeg, can be re-extracted anytime
frames/

# ── Per-measurement outputs ──────────────────────
# Large/regenerable artefacts produced inside measurements/<config>/.
# Small human-readable artefacts (tracking.csv, etc.) stay tracked
# so the repo always shows what's been measured at a glance.
week3-pendulum-free-swing/measurements/*/debug.mp4
week3-pendulum-free-swing/measurements/*/phase_3d_rotation.mp4
week3-pendulum-free-swing/measurements/*/phase_animation.mp4
week3-pendulum-free-swing/measurements/*/combined.mp4
week4-pendulum-motor-driven/measurements/*/debug.mp4
week4-pendulum-motor-driven/measurements/*/phase_3d_rotation.mp4
week4-pendulum-motor-driven/measurements/*/phase_animation.mp4
week4-pendulum-motor-driven/measurements/*/combined.mp4

# ── Figures layout ───────────────────────────────
# Per-clip MP4s (rendered animations) regenerable from CSV — too big
# to track. PNG figures stay tracked for at-a-glance browsing.
week3-pendulum-free-swing/figures/phase_3d_rotation/*.mp4
week3-pendulum-free-swing/figures/phase_animation/*.mp4
week3-pendulum-free-swing/figures/combined/*.mp4
week3-pendulum-free-swing/figures/debug/*.mp4
week4-pendulum-motor-driven/figures/phase_3d_rotation/*.mp4
week4-pendulum-motor-driven/figures/phase_animation/*.mp4
week4-pendulum-motor-driven/figures/combined/*.mp4
week4-pendulum-motor-driven/figures/debug/*.mp4

# Migration / bulk-tracking sidecar logs
week3-pendulum-free-swing/data/migration_log.txt
week3-pendulum-free-swing/data/bulk_tracking_log.json
week4-pendulum-motor-driven/data/migration_log.txt
week4-pendulum-motor-driven/data/bulk_tracking_log.json
# Long-render stdout logs from analysis scripts
week3-pendulum-free-swing/data/log_*.txt
week3-pendulum-free-swing/data/*_log.txt
week4-pendulum-motor-driven/data/log_*.txt
week4-pendulum-motor-driven/data/*_log.txt
# Per-video verdict-card transcript appended by track_one.py
week3-pendulum-free-swing/data/track_one_log.txt
week4-pendulum-motor-driven/data/track_one_log.txt
# Bulk-run streaming logs (one per chaos bulk invocation)
week3-pendulum-free-swing/data/bulk_run_*.log
week4-pendulum-motor-driven/data/bulk_run_*.log
# Batch driver logs (phase analysis, render batches, etc.)
week3-pendulum-free-swing/data/*batch_log.txt
week4-pendulum-motor-driven/data/*batch_log.txt

# Tracking-CSV backups (interpolate_suspects, fix_green_swaps, etc.)
week3-pendulum-free-swing/measurements/*/tracking.csv.bak*
week4-pendulum-motor-driven/measurements/*/tracking.csv.bak*

# Registry backups created by bulk_track.py / register_phase2_videos.py
week3-pendulum-free-swing/data/experiments.json.bulk_track_*.bak
week3-pendulum-free-swing/data/experiments.json.*.bak
week4-pendulum-motor-driven/data/experiments.json.bulk_track_*.bak
week4-pendulum-motor-driven/data/experiments.json.register_*.bak
week4-pendulum-motor-driven/data/experiments.json.*.bak

# Personal VS Code workspace
*.code-workspace
.vscode/

# ── Claude worktrees ─────────────────────────────
.claude/

# ── Python cache ─────────────────────────────────
__pycache__/
*.pyc
*.pyo

# ── Week 1 & 2 oscilloscope samples (large CSVs, not tracked) ────
week1-diode-iv/samples/
week2-rld-bifurcation/samples/

# ── Windows OS files ─────────────────────────────
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk
.DS_Store
