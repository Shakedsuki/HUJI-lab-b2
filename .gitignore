# ── Videos ──────────────────────────────────────
# All raw video files — too large for git (~3 GB total)
Videos/*.mov
Videos/*.mp4
Videos/*.avi

# ── Extracted frames ─────────────────────────────
# Generated by ffmpeg, can be re-extracted anytime
frames/

# ── Debug videos ─────────────────────────────────
# Generated by tracker, can be re-run anytime
output/*.mp4

# ── VLC snapshots ────────────────────────────────
output/vlcsnap-*.png

# ── Animation exports ────────────────────────────
# Large MP4s, regenerable from CSV
data/figures/*.mp4

# ── Per-measurement outputs ──────────────────────
# Large/regenerable artefacts produced inside measurements/<config>/.
# Small human-readable artefacts (tracking.csv, the PNG figures) stay
# tracked so the repo always shows what's been measured at a glance.
measurements/*/tracking.csv
measurements/*/verification.csv
measurements/*/debug.mp4
measurements/*/phase_3d_rotation.mp4
measurements/*/phase_animation.mp4

# Migration / bulk-tracking sidecar logs
data/migration_log.txt
data/bulk_tracking_log.json
# Long-render stdout logs from analysis scripts
data/log_*.txt
# Per-video verdict-card transcript appended by track_one.py
data/track_one_log.txt
# Bulk-run streaming logs (one per chaos bulk invocation)
data/bulk_run_*.log

# Tracking-CSV backups created by interpolate_suspects.py
measurements/*/tracking.csv.bak

# Registry backups created by bulk_track.py
data/experiments.json.bulk_track_*.bak
data/experiments.json.*.bak

# Personal VS Code workspace
*.code-workspace

# ── Claude worktrees ─────────────────────────────
.claude/

# ── Python cache ─────────────────────────────────
__pycache__/
*.pyc
*.pyo

# ── Part 1 samples (large data files) ────────────
chaos/part1/samples

# ── Windows OS files ─────────────────────────────
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk
.DS_Store
