# ── Videos ──────────────────────────────────────
# All raw video files — too large for git (~3 GB total)
Videos/*.mov
Videos/*.mp4
Videos/*.avi

# ── Extracted frames ─────────────────────────────
# Generated by ffmpeg, can be re-extracted anytime
frames/

# ── Debug videos ─────────────────────────────────
# Generated by tracker, can be re-run anytime
output/*.mp4

# ── VLC snapshots ────────────────────────────────
output/vlcsnap-*.png

# ── Python cache ─────────────────────────────────
__pycache__/
*.pyc
*.pyo

# ── Part 1 samples (large data files) ────────────
chaos/part1/samples

# ── Windows OS files ─────────────────────────────
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk
.DS_Store
